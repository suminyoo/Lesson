<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="TopSpace" style="flex-grow: 1;" />
        <ui:Label text="[Stage Clear]" name="ClearLabel" style="align-self: center; -unity-font-style: bold; color: rgb(84, 214, 90); font-size: 30px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
        <ui:VisualElement name="Buttons" style="flex-grow: 1; align-self: center; align-items: auto; justify-content: center;">
            <ui:Button text="Next Stage" name="NextStage" style="align-items: center; align-self: stretch; background-color: rgb(79, 105, 156); -unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button text="Quit" name="Quit" style="align-self: stretch; background-color: rgb(79, 105, 156); -unity-font-style: bold; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="BottomSpace" style="flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
