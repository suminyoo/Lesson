<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="TopSpace" style="flex-grow: 1;" />
        <ui:VisualElement name="Texts" style="flex-grow: 1; justify-content: space-evenly; height: 15%;">
            <ui:Label text="[Game Over]" name="GameOverLabel" enable-rich-text="false" style="align-self: center; -unity-font-style: bold; color: rgb(195, 71, 71); font-size: 30px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:Label text="All lives lost.&#10;New traps await!" name="DescriptionLabel" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 23px; -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(0, 0, 0);" />
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 1; align-self: center; align-items: auto; justify-content: center;">
            <ui:Button text="Restart Stage" name="Restart" style="align-items: center; align-self: stretch; background-color: rgb(79, 105, 156); -unity-font-style: bold; color: rgb(255, 255, 255);" />
            <ui:Button text="Quit" name="Quit" style="align-self: stretch; background-color: rgb(79, 105, 156); -unity-font-style: bold; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="BottomSpace" style="flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
